    "RibbonSpec": {
      "description": "A ribbon: a reference polyline with a lateral width profile. `y` is\npositive to the left of the direction of travel; for left-hand traffic the\nkerb is on the left (`y_max`) and the median on the right (`y_min`).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
