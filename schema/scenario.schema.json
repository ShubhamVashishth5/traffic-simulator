    "ParkingSpec": {
      "description": "Kerbside parking along one side of a ribbon (G§6.2). Parked vehicles are\ndrawn at the start of the run to fill `occupancy` of the kerb length;\nthey are road objects, so they act only by taking width (ADR-0005).\n\nThe survey quantities (`offset_from_kerb`, `double_parking_probability`,\n`manoeuvres_per_100m_h`, `cruising_share`) may be given here for this\nstretch; where omitted, the register value is used\n(`road.parking.*`), and the run is refused if that is unset too.",
      "type": "object",
      "properties": {
        "composition": {
          "description": "Vehicle types that park here, with weights.",
          "type": "object",
          "properties": {
            "auto_rickshaw": {
              "type": "number",
              "format": "double"
            },
            "bicycle": {
              "type": "number",
              "format": "double"
            },
            "bus": {
              "type": "number",
              "format": "double"
            },
            "cycle_rickshaw": {
              "type": "number",
              "format": "double"
            },
            "e_rickshaw": {
              "type": "number",
              "format": "double"
            },
            "e_two_wheeler": {
              "type": "number",
              "format": "double"
            },
            "hatchback": {
              "type": "number",
              "format": "double"
            },
            "lcv": {
              "type": "number",
              "format": "double"
            },
            "moped": {
              "type": "number",
              "format": "double"
            },
            "motorcycle": {
              "type": "number",
              "format": "double"
            },
            "scooter": {
              "type": "number",
              "format": "double"
            },
            "sedan": {
              "type": "number",
              "format": "double"
            },
            "suv": {
              "type": "number",
              "format": "double"
            },
            "tractor": {
              "type": "number",
              "format": "double"
            },
            "truck": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false
        },
        "cruising_share": {
          "description": "Share of passing vehicles (of the types that park here) that are\nlooking for a space and slow down along this stretch.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "double_parking_probability": {
          "description": "Probability that a parked vehicle has another standing beside it.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "manoeuvres_per_100m_h": {
          "description": "Parking and unparking manoeuvres per 100 m of kerb per hour.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "occupancy": {
          "description": "Share of the kerb length taken by parked vehicles at the start, 0–1\n(measure it from video or imagery).",
