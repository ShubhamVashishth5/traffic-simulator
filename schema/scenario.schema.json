{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "description": "A scenario: what to simulate, for how long, and what to record.",
  "type": "object",
  "properties": {
    "demand": {
      "description": "Arrivals at network entries.",
      "$ref": "#/$defs/DemandSpec"
    },
    "description": {
      "description": "Free-text description.",
      "type": "string",
      "default": ""
    },
    "detectors": {
      "description": "Virtual detectors (screenlines and areas).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/DetectorSpec"
      }
    },
    "dt_s": {
      "description": "Time step in seconds.",
      "type": "number",
      "format": "double",
      "default": 0.1
    },
    "duration_s": {
      "description": "Simulated duration including warm-up, in seconds.",
      "type": "number",
      "format": "double"
    },
    "kpi": {
      "description": "Which detectors the headline KPIs use.",
      "$ref": "#/$defs/KpiSpec",
      "default": {
        "throughput_detector": null
      }
    },
    "name": {
      "description": "Short identifier, used in run folder names.",
      "type": "string"
    },
    "network": {
      "description": "Road geometry.",
      "$ref": "#/$defs/NetworkSpec"
    },
    "outputs": {
      "description": "Optional outputs.",
      "$ref": "#/$defs/OutputSpec",
      "default": {
        "trajectories": null
      }
    },
    "overrides": {
      "description": "Parameter overrides by register path, in the register entry's unit.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ParamValue"
      },
      "default": {}
    },
    "warmup_s": {
      "description": "Initial period excluded from KPIs and detector summaries, in seconds.",
      "type": "number",
      "format": "double",
      "default": 0.0
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "duration_s",
    "network",
    "demand"
  ],
  "$defs": {
    "AttractorSpec": {
      "description": "A stretch of a ribbon along which the stop-anywhere rate of every class\n(`road.stop_anywhere.rate.*`) is multiplied. It changes an incentive and\nnothing else (ADR-0005).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ribbon": {
          "type": "string"
        },
        "s_from": {
          "type": "number",
          "format": "double"
        },
        "s_to": {
          "type": "number",
          "format": "double"
        },
        "stop_rate_multiplier": {
          "description": "Factor on the rate of stops per vehicle-kilometre (not on flow or\ncapacity).",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "ribbon",
        "s_from",
        "s_to",
        "stop_rate_multiplier"
      ]
    },
    "BarrierSpec": {
      "description": "A stop line across the whole carriageway. While it is closed, vehicles\nthat have not crossed it stop before it (ADR-0010; Kanagaraj & Treiber\nmodel a red light as a standing virtual vehicle across the road).",
      "type": "object",
      "properties": {
        "closed": {
          "description": "Periods during which the barrier is closed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClosedInterval"
          }
        },
        "id": {
          "type": "string"
        },
        "ribbon": {
          "type": "string"
        },
        "s": {
          "description": "Station of the stop line on the ribbon.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "ribbon",
        "s",
        "closed"
      ]
    },
    "ClosedInterval": {
      "description": "A period `from_s <= t < to_s` (simulated seconds): a barrier is closed,\nor an object is on the road.",
      "type": "object",
      "properties": {
        "from_s": {
          "type": "number",
          "format": "double"
        },
        "to_s": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "from_s",
        "to_s"
      ]
    },
    "DemandSpec": {
      "description": "Demand at the network's entries.",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntrySpec"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "entries"
      ]
    },
    "DetectorSpec": {
      "description": "A virtual detector.",
      "oneOf": [
        {
          "description": "Counts vehicles crossing station `s`.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "interval_s": {
              "type": "number",
              "format": "double",
              "default": 60.0
            },
            "kind": {
              "type": "string",
              "const": "screenline"
            },
            "ribbon": {
              "type": "string"
            },
            "s": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "ribbon",
            "s"
          ]
        },
        {
          "description": "Measures density, flow and space-mean speed over `[s_from, s_to]`\n(Edie's generalised definitions).",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "interval_s": {
              "type": "number",
              "format": "double",
              "default": 60.0
            },
            "kind": {
              "type": "string",
              "const": "area"
            },
            "ribbon": {
              "type": "string"
            },
            "s_from": {
              "type": "number",
              "format": "double"
            },
            "s_to": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "ribbon",
            "s_from",
            "s_to"
          ]
        }
      ]
    },
    "Dist": {
      "description": "A univariate distribution.\n\nSeveral lognormal forms are accepted for readability in the register; they\nare converted to `(mu, sigma)` of `ln X` by [`Dist::canonical`].",
      "oneOf": [
        {
          "description": "Always the same value.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "constant"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "value"
          ]
        },
        {
          "description": "Normal with mean and standard deviation.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "normal"
            },
            "mean": {
              "type": "number",
              "format": "double"
            },
            "sd": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "mean",
            "sd"
          ]
        },
        {
          "description": "Normal restricted to `[min, max]` (rejection sampling).",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "trunc_normal"
            },
            "max": {
              "type": "number",
              "format": "double"
            },
            "mean": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "sd": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "mean",
            "sd",
            "min",
            "max"
          ]
        },
        {
          "description": "Lognormal by the mean and SD of `ln X`.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "log_normal"
            },
            "mu": {
              "type": "number",
              "format": "double"
            },
            "sigma": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "mu",
            "sigma"
          ]
        },
        {
          "description": "Lognormal by its median and the SD of `ln X`.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "log_normal_median"
            },
            "median": {
              "type": "number",
              "format": "double"
            },
            "sigma": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "median",
            "sigma"
          ]
        },
        {
          "description": "Lognormal by the mean and SD of `X` itself.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "log_normal_moments"
            },
            "mean": {
              "type": "number",
              "format": "double"
            },
            "sd": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "mean",
            "sd"
          ]
        },
        {
          "description": "Lognormal through two quantiles: `P(X ≤ x_lo) = p_lo`, `P(X ≤ x_hi) = p_hi`.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "log_normal_quantiles"
            },
            "p_hi": {
              "type": "number",
              "format": "double"
            },
            "p_lo": {
              "type": "number",
              "format": "double"
            },
            "x_hi": {
              "type": "number",
              "format": "double"
            },
            "x_lo": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "p_lo",
            "x_lo",
            "p_hi",
            "x_hi"
          ]
        },
        {
          "description": "Gamma with shape `k` and scale `θ` (mean `kθ`).",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "gamma"
            },
            "scale": {
              "type": "number",
              "format": "double"
            },
            "shape": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "shape",
            "scale"
          ]
        },
        {
          "description": "Exponential with the given mean.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "exponential"
            },
            "mean": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "mean"
          ]
        },
        {
          "description": "`shift + Exponential`, parameterised by the shift and the overall mean.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "shifted_exponential"
            },
            "mean": {
              "type": "number",
              "format": "double"
            },
            "shift": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "shift",
            "mean"
          ]
        },
        {
          "description": "Uniform on `[min, max]`.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "uniform"
            },
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "min",
            "max"
          ]
        },
        {
          "description": "Piecewise-linear inverse CDF through `[p, x]` points, `p` rising from 0 to 1.",
          "type": "object",
          "properties": {
            "dist": {
              "type": "string",
              "const": "empirical"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "points"
          ]
        },
        {
          "description": "Finite mixture; weights need not sum to 1 (they are normalised).",
          "type": "object",
          "properties": {
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MixtureComponent"
              }
            },
            "dist": {
              "type": "string",
              "const": "mixture"
            }
          },
          "additionalProperties": false,
          "required": [
            "dist",
            "components"
          ]
        }
      ]
    },
    "EffectiveWidthSpec": {
      "description": "An effective-width observer over `[s_from, s_to]` of a ribbon, in bins\nof `bin_m` along the road. Per bin it reports the width road objects\nleave free, the shy distance the clearance model predicts for the\nvehicles that passed, and the width those vehicles actually used\n(`effective_width.parquet`). It reports; it changes nothing.",
      "type": "object",
      "properties": {
        "bin_m": {
          "description": "Length of a bin along the road (m).",
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "ribbon": {
          "type": "string"
        },
        "s_from": {
          "type": "number",
          "format": "double"
        },
        "s_to": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "ribbon",
        "s_from",
        "s_to",
        "bin_m"
      ]
    },
    "EntrySpec": {
      "description": "One entry: a flow profile and a vehicle composition (G§7.1–7.3).",
      "type": "object",
      "properties": {
        "composition": {
          "description": "Share of each vehicle type in the stream (normalised; count it at the\nsite — registration shares are not the stream, G§7.1).",
          "type": "object",
          "properties": {
            "auto_rickshaw": {
              "type": "number",
              "format": "double"
            },
            "bicycle": {
              "type": "number",
              "format": "double"
            },
            "bus": {
              "type": "number",
              "format": "double"
            },
            "cycle_rickshaw": {
              "type": "number",
              "format": "double"
            },
            "e_rickshaw": {
              "type": "number",
              "format": "double"
            },
            "e_two_wheeler": {
              "type": "number",
              "format": "double"
            },
            "hatchback": {
              "type": "number",
              "format": "double"
            },
            "lcv": {
              "type": "number",
              "format": "double"
            },
            "moped": {
              "type": "number",
              "format": "double"
            },
            "motorcycle": {
              "type": "number",
              "format": "double"
            },
            "scooter": {
              "type": "number",
              "format": "double"
            },
            "sedan": {
              "type": "number",
              "format": "double"
            },
            "suv": {
              "type": "number",
              "format": "double"
            },
            "tractor": {
              "type": "number",
              "format": "double"
            },
            "truck": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false
        },
        "flow": {
          "description": "Piecewise-constant flow: each interval applies from `from_s` until the next.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlowInterval"
          }
        },
        "id": {
          "type": "string"
        },
        "ribbon": {
          "type": "string"
        },
        "s": {
          "description": "Station of the entry on the ribbon.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "ribbon",
        "flow",
        "composition"
      ]
    },
    "FlowInterval": {
      "description": "Flow from time `from_s` onwards.",
      "type": "object",
      "properties": {
        "from_s": {
          "type": "number",
          "format": "double"
        },
        "veh_per_h": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "from_s",
        "veh_per_h"
      ]
    },
    "KpiSpec": {
      "description": "Headline KPI settings.",
      "type": "object",
      "properties": {
        "throughput_detector": {
          "description": "Screenline whose count is the throughput KPI.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "MixtureComponent": {
      "description": "One weighted component of a [`Dist::Mixture`].",
      "type": "object",
      "properties": {
        "dist": {
          "$ref": "#/$defs/Dist"
        },
        "weight": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "weight",
        "dist"
      ]
    },
    "NetworkSpec": {
      "description": "Road geometry as a set of ribbons (ADR-0002).",
      "type": "object",
      "properties": {
        "attractors": {
          "description": "Places where vehicles stop to pick up and set down more often (a\nmetro exit, a market): G§6.2, ADR-0014.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttractorSpec"
          }
        },
        "barriers": {
          "description": "Stop lines that are closed during given periods (a level crossing, a\npolice barrier). Signals arrive in phase P7.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarrierSpec"
          }
        },
        "objects": {
          "description": "Road objects: things with a position and a footprint that vehicles\nreact to (G§6, plan/03-model-design.md §10). They act only through\nusable width, speed caps, gap supply and incentives; there is no\ncapacity or flow factor to set (ADR-0005).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectSpec"
          }
        },
        "parking": {
          "description": "Stretches of kerb where vehicles park (G§6.2). Each parked vehicle\nis a road object; parking and unparking block space for a while.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParkingSpec"
          }
        },
        "ribbons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RibbonSpec"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "ribbons"
      ]
    },
    "ObjectKind": {
      "description": "What a road object is.",
      "oneOf": [
        {
          "description": "A solid body on the carriageway.",
          "type": "string",
          "const": "obstacle"
        },
        {
          "description": "A vehicle parked at the kerb, or standing beside one (double parked).",
          "type": "string",
          "const": "parked_vehicle"
        },
        {
          "description": "A vehicle manoeuvring into or out of a parking space.",
          "type": "string",
          "const": "parking_manoeuvre"
        }
      ]
    },
    "ObjectResponse": {
      "description": "How one vehicle class responds to a road object.",
      "oneOf": [
        {
          "description": "The footprint is not usable: the class goes around it or stops.",
          "type": "string",
          "const": "block"
        },
        {
          "description": "The class takes no notice of the object.",
          "type": "string",
          "const": "ignore"
        }
      ]
    },
    "ObjectSpec": {
      "description": "A road object: a rectangle lying along a ribbon (a parked vehicle, a\nvendor's cart, debris). Vehicles see it as a standing body: they keep\ntheir lateral clearance to it, brake for it and steer around it like\nthey do for a stopped vehicle.",
      "type": "object",
      "properties": {
        "clearance_as": {
          "description": "The vehicle class whose lateral-clearance line and following\nmultipliers apply to this object (a parked car is passed like a\ncar). Omit for the pooled clearance line.",
          "anyOf": [
            {
              "$ref": "#/$defs/VehicleClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind",
          "default": "obstacle"
        },
        "length": {
          "description": "Extent of the footprint along the ribbon (m).",
          "type": "number",
          "format": "double"
        },
        "present": {
          "description": "Periods during which the object is on the road; empty means always.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClosedInterval"
          }
        },
        "response": {
          "description": "How each vehicle class responds; classes not listed are blocked.",
          "type": "object",
          "properties": {
            "auto_rickshaw": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "bicycle": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "bus": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "car": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "cycle_rickshaw": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "e_rickshaw": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "lcv": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "tractor": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "truck": {
              "$ref": "#/$defs/ObjectResponse"
            },
            "two_wheeler": {
              "$ref": "#/$defs/ObjectResponse"
            }
          },
          "additionalProperties": false
        },
        "ribbon": {
          "type": "string"
        },
        "s": {
          "description": "Station of the footprint's centre on the ribbon (m).",
          "type": "number",
          "format": "double"
        },
        "width": {
          "description": "Extent of the footprint across the ribbon (m).",
          "type": "number",
          "format": "double"
        },
        "y": {
          "description": "Lateral position of the footprint's centre (m).",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "ribbon",
        "s",
        "y",
        "length",
        "width"
      ]
    },
    "OutputSpec": {
      "description": "Optional outputs.",
      "type": "object",
      "properties": {
        "effective_width": {
          "description": "Effective-width observers: how much of the carriageway traffic\nuses, against what road objects leave free (G§6.2).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectiveWidthSpec"
          }
        },
        "trajectories": {
          "description": "Trajectory sampling; omit to write no trajectories.",
          "anyOf": [
            {
              "$ref": "#/$defs/TrajectorySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
