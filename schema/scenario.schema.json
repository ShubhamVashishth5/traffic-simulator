              "$ref": "#/$defs/Dist"
            },
            {
              "type": "null"
            }
          ]
        },
        "ribbon": {
          "type": "string"
        },
        "s_from": {
          "description": "The stretch of kerb, by station (m).",
          "type": "number",
          "format": "double"
        },
        "s_to": {
          "type": "number",
          "format": "double"
        },
        "side": {
          "description": "Which edge of the carriageway the vehicles park at.",
          "$ref": "#/$defs/RoadSide",
          "default": "left"
        }
